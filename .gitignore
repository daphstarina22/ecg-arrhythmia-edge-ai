# ==============================================================================
# ECG Arrhythmia Edge AI - Git Ignore Configuration
# ==============================================================================

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Downloaded Archives & Raw Waveform Datasets ---
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.dat
*.hea
*.atr
*.mat

# Large dataset CSV files
*.csv
# But preserve curated benchmark comparison summary tables:
!training/final_models/results/*_comparison_table.csv
!training/final_models/results/*_confusion_matrix.json

# --- Temporary & Log Files ---
tmp/
temp/
logs/
*.log

# --- Python Build & Packaging ---
build/
dist/
*.egg-info/
*.egg

# --- EXPLICIT WHITELIST: Ensure Trained ONNX Deployment Models Remain Tracked ---
!deploy/models/*.onnx
!models/*.onnx
!training/final_models/export_candidates/*.onnx
